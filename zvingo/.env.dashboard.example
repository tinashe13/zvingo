# ==============================================================================
# Zvingo — MERCHANT DASHBOARD HOST environment  (split deployment, host B of two)
# ==============================================================================
#
#   cp .env.dashboard.example .env     # then fill in EVERY value marked REQUIRED
#   docker compose -f docker-compose.dashboard.yml up -d --build
#
# This host runs only the Next.js dashboard behind its own nginx. It holds NO
# database and NO application secrets — the browser authenticates against the
# API host directly. The only sensitive files here are the TLS certificates.
#
#   *** NEVER COMMIT THE FILLED-IN .env ***
#   chmod 600 .env
#
# The Next.js build needs roughly 1.5 GB of RAM. On a 1-2 GB droplet add swap
# first (see DEPLOYMENT.md "Build runs out of memory") or the kernel OOM-killer
# will terminate the build with a bare "signal: killed".
# ==============================================================================


# ==============================================================================
# 1. DOMAIN
# ==============================================================================
# The dashboard domain. Documentation only — you must ALSO edit the two
# `server_name` lines (port 80 and port 443) in nginx/nginx.dashboard.conf.
#
# Whatever you put here must ALSO appear in CORS_ORIGINS on the BACKEND host,
# or every request from this dashboard is blocked by CORS.
# [REQUIRED]
DASHBOARD_DOMAIN=app.your-domain.com


# ==============================================================================
# 2. API LOCATION — BUILD-TIME VALUES
# ==============================================================================
# Next.js inlines NEXT_PUBLIC_* into the browser bundle and resolves the /api/*
# rewrite when the IMAGE IS BUILT, so changing either value below needs
#   docker compose -f docker-compose.dashboard.yml up -d --build
# A restart alone will NOT pick them up.
#
# Because they ship to the browser, NEVER put a secret in a NEXT_PUBLIC_* var.
# Anyone can read them by opening dev tools.

# The API host, INCLUDING the /api prefix.
# Leaving it blank breaks image uploads: the code falls back to
# http://localhost:8000, which in a visitor's browser means THEIR OWN MACHINE.
# [REQUIRED]
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api

# Server-side rewrite target for server-rendered fetches. In a split deployment
# the browser calls the API host directly, so this only matters for SSR — point
# it at the same public API host. Defaults to NEXT_PUBLIC_API_URL, which is
# correct here. Never localhost: that is this container.
# [OPTIONAL] default: the value of NEXT_PUBLIC_API_URL
#API_PROXY_URL=https://api.your-domain.com/api

# Initial map centre for the restaurant location picker.
# Leave blank to use the in-code default (Harare, -17.82 / 31.05).
# [OPTIONAL]
NEXT_PUBLIC_DEFAULT_RESTAURANT_LAT=
NEXT_PUBLIC_DEFAULT_RESTAURANT_LNG=


# ==============================================================================
# 3. BUILD TUNING
# ==============================================================================
# V8 heap cap for `next build`, in MB. The build needs roughly 1.5 GB. On a
# 1-2 GB droplet, lower this AND add swap so Node garbage-collects instead of
# being killed.
# [OPTIONAL] default: 1536
#NODE_BUILD_MEMORY_MB=1536


# ==============================================================================
# PRE-FLIGHT CHECKLIST — tick all of these before `up -d --build`
# ==============================================================================
#  [ ] NEXT_PUBLIC_API_URL points at the API host and ends in /api
#  [ ] This host's origin is listed in CORS_ORIGINS on the BACKEND host
#  [ ] server_name updated in BOTH server blocks of nginx/nginx.dashboard.conf
#  [ ] TLS certs present at nginx/certs/{fullchain,privkey}.pem
#  [ ] Certificate auto-renewal cron installed (certs expire in 90 days)
#  [ ] Swap configured if this droplet has less than 4 GB of RAM
#  [ ] This .env is chmod 600 and is NOT tracked by git
