# Zvingo — MERCHANT DASHBOARD HOST environment (split deployment).
#
# Usage:
#   cp .env.dashboard.example .env
#   # fill in EVERY value below, then:
#   docker compose -f docker-compose.dashboard.yml up -d --build
#
# This host runs only the Next.js dashboard. It holds no database and no
# application secrets — the browser authenticates against the API host
# directly. NEVER commit the filled-in .env.

# ============================================================
# Domain
# ============================================================
# The dashboard domain. Also update both server_name lines in
# nginx/nginx.dashboard.conf.
DASHBOARD_DOMAIN=app.zvingo.example.com

# ============================================================
# API location — BUILD-TIME values
# ============================================================
# Next.js inlines NEXT_PUBLIC_* into the client bundle and resolves the
# /api/* rewrite when the image is built, so changing either of these needs
#   docker compose -f docker-compose.dashboard.yml up -d --build
# A restart alone will NOT pick them up.
#
# The API host, including the /api prefix. Leaving it blank breaks image
# uploads — the code falls back to http://localhost:8000, which in a browser
# means the visitor's own machine.
NEXT_PUBLIC_API_URL=https://api.zvingo.example.com/api

# Server-side rewrite target for server-rendered fetches. Defaults to
# NEXT_PUBLIC_API_URL, which is correct for a split deployment.
#API_PROXY_URL=https://api.zvingo.example.com/api

# Optional map centre for the restaurant location picker.
NEXT_PUBLIC_DEFAULT_RESTAURANT_LAT=
NEXT_PUBLIC_DEFAULT_RESTAURANT_LNG=

# ============================================================
# Build tuning
# ============================================================
# V8 heap cap for `next build`, in MB. The build needs roughly 1.5 GB; on a
# 1-2 GB droplet add swap as well or the kernel kills it ("signal: killed").
#NODE_BUILD_MEMORY_MB=1536
