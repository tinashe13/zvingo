# Zvingo — production environment template.
#
# Usage:
#   cp .env.production.example .env
#   # fill in EVERY value below, then:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# docker compose reads this file automatically when it is named `.env` and
# sits next to docker-compose.prod.yml. Every ${VAR:?} in the compose file
# will fail fast at startup if left empty — there are no insecure defaults.
#
# NEVER commit the filled-in .env to git.

# ============================================================
# Domain / public URLs
# ============================================================
# Your public domain (also update server_name in nginx/nginx.prod.conf)
DOMAIN=zvingo.example.com

# Public base URL used by the backend to build uploaded-image URLs.
# Must be https://<DOMAIN> — images are served via nginx at /static/uploads/.
UPLOAD_BASE_URL=https://zvingo.example.com

# Allowed browser origins for CORS (comma-separated). REQUIRED in production:
# when this is empty the backend allows no browser origin at all, and every
# dashboard request fails CORS.
CORS_ORIGINS=https://zvingo.example.com

# ============================================================
# Merchant dashboard (Next.js) — BUILD-TIME values
# ============================================================
# Next.js inlines NEXT_PUBLIC_* into the client bundle and resolves the
# /api/* rewrite when the image is built, so changing these later requires
# `up -d --build merchant-dashboard`, not just a restart.
#
# Public API gateway the browser talks to. Must include the /api prefix.
# Leaving it blank breaks image uploads (the code falls back to
# http://localhost:8000, which in a browser is the user's own machine).
NEXT_PUBLIC_API_URL=https://zvingo.example.com/api

# Server-side rewrite target inside the compose network. Leave as-is unless
# you rename the nginx service. Never localhost — that is the dashboard
# container itself.
API_PROXY_URL=http://nginx:80

# Optional map centre for the restaurant location picker.
NEXT_PUBLIC_DEFAULT_RESTAURANT_LAT=
NEXT_PUBLIC_DEFAULT_RESTAURANT_LNG=

# ============================================================
# Security
# ============================================================
# JWT signing key. REQUIRED. Generate with:
#   openssl rand -hex 32
SECRET_KEY=

# ============================================================
# MongoDB (root credentials — auth is enabled in production)
# ============================================================
MONGO_INITDB_ROOT_USERNAME=zvingo_admin
# Generate with: openssl rand -hex 24
MONGO_INITDB_ROOT_PASSWORD=
# Application database name (default: zvingo)
MONGODB_DB_NAME=zvingo

# ============================================================
# Redis
# ============================================================
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=

# ============================================================
# Payments — Paynow Zimbabwe (https://www.paynow.co.zw/)
# Get Integration ID and Key from your Paynow merchant dashboard.
# ============================================================
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Where Paynow redirects the customer after payment (browser redirect)
PAYNOW_RETURN_URL=https://zvingo.example.com/payment/return
# Server-to-server webhook Paynow calls with the payment result
PAYNOW_RESULT_URL=https://zvingo.example.com/api/payment/webhook

# ============================================================
# SMS — Africa's Talking (https://africastalking.com/)
# Use your LIVE username + API key in production, not "sandbox".
# (The dev SMS mock and SMS_GATEWAY_URL are not used in production.)
# ============================================================
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# ============================================================
# Firebase Cloud Messaging (push notifications)
# Path to the service-account JSON *inside the backend container*.
# The backend Dockerfile copies backend/firebase-credentials.json to /app,
# so the default is usually correct.
# ============================================================
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ============================================================
# Observability (all optional — sensible defaults if omitted)
# ============================================================
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR. Production always emits JSON.
#LOG_LEVEL=INFO

# GET /metrics (Prometheus text format). nginx already denies it from the
# public internet; scrape http://backend:8000/metrics from inside the compose
# network. Set a token to require `Authorization: Bearer <token>` as well.
#METRICS_ENABLED=true
#METRICS_TOKEN=

# Background monitor for stuck orders, payment-failure spikes, and orders that
# exhaust their dispatch retries. Results are logged, published to the Redis
# `alerts` channel, and served at GET /api/admin/alerts.
#ALERTS_ENABLED=true
#ALERT_POLL_INTERVAL_SECONDS=300
#ALERT_STUCK_ORDER_MINUTES=30
#ALERT_FAILED_PAYMENT_THRESHOLD=5

# Scheduled orders: how often to look for due orders, and how far ahead of the
# requested slot to release them for dispatch.
#SCHEDULED_POLL_INTERVAL_SECONDS=15
#SCHEDULED_DISPATCH_LEAD_MINUTES=15
