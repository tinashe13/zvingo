# ==============================================================================
# Zvingo — SINGLE-HOST PRODUCTION environment
# ==============================================================================
#
#   cp .env.production.example .env     # then fill in EVERY value marked REQUIRED
#   docker compose -f docker-compose.prod.yml up -d --build
#
# docker compose reads a file named `.env` sitting next to the compose file
# automatically. This layout runs backend + dashboard + Mongo + Redis + nginx on
# ONE host. For two hosts use .env.backend.example and .env.dashboard.example.
#
# Every ${VAR:?} in docker-compose.prod.yml fails fast at startup if left empty.
# There are deliberately NO insecure defaults.
#
#   *** NEVER COMMIT THE FILLED-IN .env ***
#   chmod 600 .env    — mode 644 is readable by every user on the box.
#
# Signup instructions, costs and lead times for every provider below:
#   docs/INTEGRATIONS_AND_CREDENTIALS.md
# ==============================================================================


# ==============================================================================
# 1. DOMAIN AND PUBLIC URLs
# ==============================================================================
# Your public domain. Documentation only — you must ALSO edit the two
# `server_name` lines (port 80 and port 443) in nginx/nginx.prod.conf by hand.
#
# NOTE: the repo is currently inconsistent about the domain — nginx and these
# examples say pindira.com, while consumer_app/BUILD.md and driver_app/BUILD.md
# use a placeholder. Pick ONE name and make every file agree BEFORE you build
# the mobile apps: the API host is compiled into the binary, so a wrong value
# means a new store submission, not a config change.
# [REQUIRED]
DOMAIN=your-domain.com

# Public base URL the backend prefixes onto uploaded-image links. Must be
# https://<DOMAIN> — nginx serves the files at /static/uploads/. A wrong value
# makes every menu photo 404 in the apps.
# [REQUIRED]
UPLOAD_BASE_URL=https://your-domain.com

# Comma-separated browser origins allowed to call the API.
# [REQUIRED] In production an EMPTY value means NO browser origin is allowed,
# and every merchant-dashboard request fails CORS. "*" is not legal here —
# the backend sends credentials.
CORS_ORIGINS=https://your-domain.com


# ==============================================================================
# 2. MERCHANT DASHBOARD (Next.js) — BUILD-TIME VALUES
# ==============================================================================
# Next.js inlines NEXT_PUBLIC_* into the browser bundle and resolves the /api/*
# rewrite when the IMAGE IS BUILT. Changing these later needs
#   docker compose -f docker-compose.prod.yml up -d --build merchant-dashboard
# A restart alone will NOT pick them up.
#
# Because they ship to the browser, NEVER put a secret in a NEXT_PUBLIC_* var.

# Public API gateway the browser talks to. MUST include the /api prefix.
# Leaving it blank makes the upload path fall back to http://localhost:8000 —
# which, in a visitor's browser, is THEIR OWN MACHINE. Image uploads then fail
# with a confusing connection error.
# [REQUIRED]
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# Server-side rewrite target for server-rendered fetches, resolved INSIDE the
# compose network. Leave as-is unless you rename the nginx service.
# Never localhost — that would be the dashboard container itself.
# [OPTIONAL] default: http://nginx:80
API_PROXY_URL=http://nginx:80

# Initial map centre for the restaurant location picker in the dashboard.
# Leave blank to use the in-code default (Harare, -17.82 / 31.05).
# [OPTIONAL]
NEXT_PUBLIC_DEFAULT_RESTAURANT_LAT=
NEXT_PUBLIC_DEFAULT_RESTAURANT_LNG=


# ==============================================================================
# 3. SECURITY
# ==============================================================================
# JWT signing key. Anyone holding this can forge a token for ANY user,
# including an admin.
#
#   [REQUIRED] Generate with:  openssl rand -hex 32
#
# Placeholders (changethis, changeme, secret, ...) are rejected outright by
# config.py in production. Do not pick a memorable phrase.
# Rotating this logs out every user — schedule it for 03:00, not lunchtime.
SECRET_KEY=


# ==============================================================================
# 4. MONGODB  (root credentials — auth is enabled in production)
# ==============================================================================
# The root user is created on the FIRST boot of an empty volume. Changing the
# password here later does NOT change the existing user — you must alter it
# inside Mongo as well.
# [REQUIRED]
MONGO_INITDB_ROOT_USERNAME=zvingo_admin

# [REQUIRED] SECRET. Generate with:  openssl rand -hex 24
MONGO_INITDB_ROOT_PASSWORD=

# Application database name.
# [OPTIONAL] default: zvingo
MONGODB_DB_NAME=zvingo


# ==============================================================================
# 5. REDIS
# ==============================================================================
# [REQUIRED] SECRET. Generate with:  openssl rand -hex 24
# Becomes `redis-server --requirepass`. Redis is NOT published to the host —
# it is reachable only on the internal compose network. Keep it that way.
REDIS_PASSWORD=


# ==============================================================================
# 6. PAYMENTS — Paynow Zimbabwe  (https://www.paynow.co.zw/)
# EcoCash / OneMoney / InnBucks. The only way money enters the platform, and a
# confirmed payment is what triggers driver dispatch.
# Signup walkthrough: docs/INTEGRATIONS_AND_CREDENTIALS.md §2.1
# ==============================================================================
# Paynow merchant dashboard -> "Other Ways To Get Paid" -> your integration.
# The ID is per-integration, not per-account.
# [REQUIRED] — the backend refuses to start in production without it.
PAYNOW_INTEGRATION_ID=

# [REQUIRED] SECRET. Never shown on screen: click [Email Key To Company Address]
# in the Paynow dashboard. Delete that email once the key is in your vault.
PAYNOW_INTEGRATION_KEY=

# Where Paynow redirects the customer's BROWSER after payment.
# [REQUIRED]
PAYNOW_RETURN_URL=https://your-domain.com/payment/return

# Server-to-server callback Paynow POSTs the payment result to. Must be
# publicly reachable over HTTPS, and must match the result URL saved on the
# integration in the Paynow dashboard.
#
# The public path is /api/payment/webhook — nginx rewrites away the /api prefix
# before proxying. Despite its name, API_V1_STR is NOT a route prefix, so do
# not use /api/v1/... here.
#
# SECURITY: the handler does not yet validate Paynow's SHA-512 `hash` field.
# Until it does, this endpoint will accept a forged "paid" callback. See
# docs/INTEGRATIONS_AND_CREDENTIALS.md §8 — do not go live before it is fixed.
# [REQUIRED]
PAYNOW_RESULT_URL=https://your-domain.com/api/payment/webhook

# Mock mode defaults to TRUE in app/config.py for local development, and the
# production validator refuses to start while it is on. docker-compose.prod.yml
# already pins it to false; override here only if you know why.
# [OPTIONAL] compose default: false    *** NEVER set this to true in production ***
#PAYMENT_MOCK_MODE=false


# ==============================================================================
# 7. SMS — Africa's Talking  (https://africastalking.com/)
# Sends the signup OTP and password-reset code. Without working SMS NOBODY CAN
# SIGN UP OR LOG IN. Going live needs Zimbabwean company KYC documents and a
# registered sender ID — allow 1-3 weeks.
# Signup walkthrough: docs/INTEGRATIONS_AND_CREDENTIALS.md §2.2
# ==============================================================================
# Your LIVE app username — NOT the literal string "sandbox". The username is
# the ONLY sandbox/live switch in the code: "sandbox" routes to
# api.sandbox.africastalking.com no matter which API key you supply.
# [REQUIRED]
AFRICASTALKING_USERNAME=

# [REQUIRED] SECRET. Dashboard -> your app -> Settings -> API Key.
# Shown exactly once at generation.
AFRICASTALKING_API_KEY=

# Africa's Talking is PRE-PAID. An empty balance fails silently: the send is
# logged as an error and the OTP endpoint still returns success to the client,
# so users see "code sent" and get nothing. Monitor your credit balance and
# alert on the "SMS send failed" log event.

# SMS_GATEWAY_URL is the local dev mock only and is intentionally NOT set here.

# [OPTIONAL] compose default: false    *** NEVER set this to true in production ***
#SMS_MOCK_MODE=false


# ==============================================================================
# 8. PUSH NOTIFICATIONS — Firebase Cloud Messaging  (free at any volume)
# ==============================================================================
# Path to the service-account JSON *inside the backend container*. The backend
# Dockerfile copies backend/firebase-credentials.json to /app, so the default is
# usually correct. Missing file => push disabled with a log line; nothing else
# breaks. chmod 600 the JSON on the host — it can push to every user you have.
#
# NOTE: this achieves nothing on its own today. Neither Flutter app has an FCM
# client, so User.fcm_token is never populated. See §2.3 of the integrations doc.
# [OPTIONAL] default: firebase-credentials.json
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json


# ==============================================================================
# 9. OBSERVABILITY  (all optional — defaults match app/config.py)
# ==============================================================================
# DEBUG | INFO | WARNING | ERROR. Production always emits JSON regardless.
#LOG_LEVEL=INFO

# GET /metrics in Prometheus text format. nginx already denies /api/metrics from
# the public internet; scrape http://backend:8000/metrics from inside the
# compose network. Set a token to additionally require a bearer header.
# Generate with: openssl rand -hex 16
#METRICS_ENABLED=true
#METRICS_TOKEN=

# Background monitor for stuck orders, payment-failure spikes, and orders that
# exhaust their dispatch retries. Logged, published to the Redis `alerts`
# channel, and served at GET /api/admin/alerts.
# Tune ALERT_FAILED_PAYMENT_THRESHOLD DOWN for launch — 5 failures is a lot when
# you are doing 30 orders a day.
#ALERTS_ENABLED=true
#ALERT_POLL_INTERVAL_SECONDS=300
#ALERT_STUCK_ORDER_MINUTES=30
#ALERT_FAILED_PAYMENT_THRESHOLD=5
#ALERT_WINDOW_MINUTES=60


# ==============================================================================
# 10. SCHEDULED ORDERS  (optional)
# ==============================================================================
# How often to look for orders whose slot is approaching, and how far ahead of
# the requested time to release one — so the driver ARRIVES for the slot rather
# than setting off at it.
#SCHEDULED_POLL_INTERVAL_SECONDS=15
#SCHEDULED_DISPATCH_LEAD_MINUTES=15


# ==============================================================================
# PRE-FLIGHT CHECKLIST — tick all of these before `up -d --build`
# ==============================================================================
#  [ ] SECRET_KEY generated with `openssl rand -hex 32` (not a phrase)
#  [ ] MONGO_INITDB_ROOT_PASSWORD and REDIS_PASSWORD generated separately
#  [ ] All four Paynow values filled, integration switched OUT of test mode
#  [ ] Africa's Talking LIVE username (not "sandbox") + funded credit balance
#  [ ] CORS_ORIGINS lists every origin the dashboard is served from
#  [ ] server_name updated in BOTH server blocks of nginx/nginx.prod.conf
#  [ ] TLS certs present at nginx/certs/{fullchain,privkey}.pem
#  [ ] Certificate auto-renewal cron installed (certs expire in 90 days)
#  [ ] firebase-credentials.json in place and chmod 600
#  [ ] This .env is chmod 600 and is NOT tracked by git
#  [ ] Master copies of every secret stored in the company password manager
#  [ ] Host firewall allows 22, 80, 443, 9090/udp, 9091/tcp and nothing else
#  [ ] Database backups configured AND a restore tested
