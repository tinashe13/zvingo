# ==============================================================================
# Zvingo Backend — environment configuration
# ==============================================================================
#
#   cp .env.example .env     # then edit .env (NEVER commit .env)
#
# Every variable below is read by backend/app/config.py (the Settings class).
# Anything not listed here is not read by the backend.
#
# Markers used in this file:
#   [REQUIRED]      the app will not start without it
#   [REQUIRED-PROD] the app refuses to start when ENVIRONMENT=production
#   [OPTIONAL]      has a safe default; uncomment only to change it
#   *** CHANGE BEFORE PRODUCTION ***  a dev default that is unsafe in production
#
# The production safety validator in config.py refuses to start with
# ENVIRONMENT=production unless ALL of these hold:
#   - SECRET_KEY is set and is not a known placeholder
#   - PAYMENT_MOCK_MODE=false AND PAYNOW_INTEGRATION_ID/KEY are both set
#   - SMS_MOCK_MODE=false AND AFRICASTALKING_API_KEY is set
# That is deliberate. A failed production start is the guard working, not a bug.
#
# Full provider signup instructions, costs and lead times:
#   docs/INTEGRATIONS_AND_CREDENTIALS.md
# ==============================================================================


# ------------------------------------------------------------------------------
# ENVIRONMENT
# ------------------------------------------------------------------------------
# "development" — permissive: CORS defaults to "*", mock modes allowed.
# "production"  — runs the safety validator above and forces JSON logging.
# [OPTIONAL] default: development
ENVIRONMENT=development


# ------------------------------------------------------------------------------
# DATABASE — MongoDB (motor / Beanie)
# ------------------------------------------------------------------------------
# [REQUIRED] No default. The app will not start without it.
# Dev (docker compose, no auth):
MONGODB_URL=mongodb://mongo:27017/zvingo
# Production (auth enabled — note ?authSource=admin):
#MONGODB_URL=mongodb://zvingo_admin:REPLACE_WITH_MONGO_PASSWORD@mongo:27017/zvingo?authSource=admin

# Application database name.
# [OPTIONAL] default: zvingo
MONGODB_DB_NAME=zvingo


# ------------------------------------------------------------------------------
# REDIS — dispatch pub/sub, OTP storage, rate limiting, exchange rates
# ------------------------------------------------------------------------------
# [REQUIRED] No default. The app will not start without it.
# Dev (no password):
REDIS_URL=redis://redis:6379/0
# Production (note the leading ':' — Redis AUTH has no username):
#REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0


# ------------------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------------------
# JWT signing key. Anyone holding this can forge a token for ANY user,
# including an admin.
#
#   *** CHANGE BEFORE PRODUCTION ***
#   Generate with:  openssl rand -hex 32
#
# config.py rejects these placeholders in production: changethis, changeme,
# secret, generate-a-random-64-char-string-here.
# Do not pick a memorable phrase — a human-chosen key is a guessable key.
# [REQUIRED-PROD] default: changethis
SECRET_KEY=changethis

# JWT algorithm. [OPTIONAL] default: HS256 — leave alone.
#ALGORITHM=HS256

# Token lifetime in minutes. Long by design so drivers are not logged out
# mid-shift. [OPTIONAL] default: 11520 (8 days)
#ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Comma-separated list of browser origins allowed to call this API.
#   - Empty in development  => "*" (any origin)
#   - Empty in production   => NO origin is allowed, and every merchant-dashboard
#                              request fails CORS. This is a common self-inflicted
#                              outage. Always set it in production.
# "*" is not a legal value in production: the backend sends credentials.
# [REQUIRED-PROD in practice] default: empty
# Example: CORS_ORIGINS=https://app.your-domain.com,https://your-domain.com
CORS_ORIGINS=


# ------------------------------------------------------------------------------
# SMS — Africa's Talking  (https://africastalking.com/)
# Sends the signup OTP and the password-reset code. Without working SMS
# NOBODY CAN SIGN UP OR LOG IN. See docs/INTEGRATIONS_AND_CREDENTIALS.md §2.2.
# ------------------------------------------------------------------------------
# true  => messages are POSTed to SMS_GATEWAY_URL (if set) or just logged.
# false => messages go to Africa's Talking for real.
#   *** CHANGE BEFORE PRODUCTION: must be false ***
# [REQUIRED-PROD] default: true
SMS_MOCK_MODE=true

# The literal string "sandbox" routes to api.sandbox.africastalking.com.
# ANY other value routes to the live API. This is the ONLY sandbox/live switch
# in the code — the API key alone does not change the environment.
#   *** CHANGE BEFORE PRODUCTION: use your live app username ***
# [REQUIRED-PROD] default: sandbox
AFRICASTALKING_USERNAME=sandbox

# SECRET. Africa's Talking dashboard -> your app -> Settings -> API Key.
# Shown exactly once at generation; copy it immediately.
# [REQUIRED-PROD] default: empty
AFRICASTALKING_API_KEY=

# DEVELOPMENT ONLY. Local mock SMS receiver (the `sms-mock` service in
# docker-compose.yml). Never set this in production.
# [OPTIONAL] default: unset
SMS_GATEWAY_URL=http://sms-mock:8000

# NOTE: backend/app/sms/router.py reads AT_USERNAME / AT_API_KEY via os.getenv.
# Those names are NOT part of Settings and are not read anywhere else. Do not
# set them here — that would store the same secret under two names. The router
# needs fixing to use settings instead (tracked in
# docs/INTEGRATIONS_AND_CREDENTIALS.md §8).


# ------------------------------------------------------------------------------
# PAYMENTS — Paynow Zimbabwe  (https://www.paynow.co.zw/)
# EcoCash / OneMoney / InnBucks. This is the only way money enters the platform,
# and a successful payment is what triggers driver dispatch.
# See docs/INTEGRATIONS_AND_CREDENTIALS.md §2.1.
# ------------------------------------------------------------------------------
# true  => payments never contact Paynow and auto-approve after ~3 seconds.
# false => real Paynow calls.
#   *** CHANGE BEFORE PRODUCTION: must be false ***
# [REQUIRED-PROD] default: true
PAYMENT_MOCK_MODE=true

# Paynow merchant dashboard -> "Other Ways To Get Paid" -> your integration.
# The ID is per-integration, not per-account.
# [REQUIRED-PROD] default: empty
PAYNOW_INTEGRATION_ID=

# SECRET. Never displayed on screen — click [Email Key To Company Address] in
# the Paynow dashboard and it is mailed to you. Delete that email afterwards.
# [REQUIRED-PROD] default: empty
PAYNOW_INTEGRATION_KEY=

# Where Paynow redirects the customer's BROWSER after payment.
# [OPTIONAL but set it] default: http://localhost/payment/return
PAYNOW_RETURN_URL=http://localhost/payment/return

# Server-to-server callback Paynow POSTs the payment result to. Must be
# reachable from the public internet over HTTPS in production, and must match
# the result URL configured on the integration in the Paynow dashboard.
#
# The public path is /api/payment/webhook — nginx rewrites away the /api
# prefix before proxying (rewrite ^/api/(.*) /$1 break). Despite the name,
# API_V1_STR is NOT a route prefix, so do not use /api/v1/... here.
# [OPTIONAL but set it] default: http://localhost/api/payment/webhook
PAYNOW_RESULT_URL=http://localhost/api/payment/webhook


# ------------------------------------------------------------------------------
# PUSH NOTIFICATIONS — Firebase Cloud Messaging
# Free at any volume. See docs/INTEGRATIONS_AND_CREDENTIALS.md §2.3.
#   1. Create a project at https://console.firebase.google.com/
#   2. Project settings -> Service accounts -> Generate new private key
#   3. Save the JSON as backend/firebase-credentials.json  (chmod 600)
#
# NOTE: configuring this alone achieves nothing today. Neither Flutter app has
# an FCM client, so User.fcm_token is always null and no push is ever attempted.
# ------------------------------------------------------------------------------
# Path INSIDE the container. Relative paths resolve against /app, where the
# Dockerfile copies backend/firebase-credentials.json.
# If the file is missing, push is disabled with a log line; nothing else breaks.
# [OPTIONAL] default: unset (push disabled)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json


# ------------------------------------------------------------------------------
# UPLOADS
# ------------------------------------------------------------------------------
# Public base URL prefixed onto returned image URLs. MUST be the host that
# actually serves /static/uploads/ — a wrong value 404s every menu photo.
# [OPTIONAL but set it] default: http://localhost:8000
UPLOAD_BASE_URL=http://localhost:8000

# Maximum accepted upload size in bytes. Keep in step with nginx's
# client_max_body_size or nginx will reject the request before the app sees it.
# [OPTIONAL] default: 5242880 (5 MB)
#MAX_UPLOAD_SIZE_BYTES=5242880


# ------------------------------------------------------------------------------
# BINPROTO — binary location protocol (driver telemetry)
# The driver app talks to these ports DIRECTLY, bypassing nginx and TLS.
# Open them on the host firewall; note the traffic is currently plaintext.
# ------------------------------------------------------------------------------
# [OPTIONAL] default: 9090
BINPROTO_UDP_PORT=9090
# [OPTIONAL] default: 9091
BINPROTO_TCP_PORT=9091


# ------------------------------------------------------------------------------
# DISPATCH — re-offering stuck orders
# ------------------------------------------------------------------------------
# Seconds between re-offer sweeps. [OPTIONAL] default: 120
#DISPATCH_RETRY_INTERVAL_SECONDS=120
# Give up (and alert) after this many re-offers. [OPTIONAL] default: 10
#DISPATCH_MAX_RETRY_ATTEMPTS=10


# ------------------------------------------------------------------------------
# SCHEDULED ORDERS
# How often to look for orders whose slot is approaching, and how far ahead of
# the requested time to release one for dispatch — so the driver ARRIVES for the
# slot rather than setting off at it.
# ------------------------------------------------------------------------------
# [OPTIONAL] default: 15
#SCHEDULED_POLL_INTERVAL_SECONDS=15
# [OPTIONAL] default: 15
#SCHEDULED_DISPATCH_LEAD_MINUTES=15


# ------------------------------------------------------------------------------
# OBSERVABILITY
# ------------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. [OPTIONAL] default: INFO
#LOG_LEVEL=INFO

# One JSON object per log line. Always forced on when ENVIRONMENT=production,
# whatever this says. [OPTIONAL] default: false
#LOG_JSON=false

# Prometheus text-format metrics at GET /metrics. [OPTIONAL] default: true
#METRICS_ENABLED=true

# When set, /metrics additionally requires `Authorization: Bearer <token>`.
# Optional because nginx already denies /api/metrics from the public internet;
# scrape http://backend:8000/metrics from inside the compose network instead.
# Generate with: openssl rand -hex 16
# [OPTIONAL] default: unset (no bearer auth)
#METRICS_TOKEN=


# ------------------------------------------------------------------------------
# ALERTING
# A background monitor raises alerts for stuck orders, payment-failure spikes,
# and orders that exhaust their dispatch retries. Alerts are logged, published
# to the Redis `alerts` channel, and served at GET /api/admin/alerts.
# ------------------------------------------------------------------------------
# [OPTIONAL] default: true
#ALERTS_ENABLED=true
# Seconds between sweeps. [OPTIONAL] default: 300
#ALERT_POLL_INTERVAL_SECONDS=300
# An order stuck in one state this long raises an alert. [OPTIONAL] default: 30
#ALERT_STUCK_ORDER_MINUTES=30
# Failed payments within ALERT_WINDOW_MINUTES before alerting. Tune this DOWN
# for launch — 5 failures is a lot at 30 orders/day. [OPTIONAL] default: 5
#ALERT_FAILED_PAYMENT_THRESHOLD=5
# [OPTIONAL] default: 60
#ALERT_WINDOW_MINUTES=60
# In-memory ring buffer of recent alerts. [OPTIONAL] default: 100
#ALERT_HISTORY_SIZE=100


# ------------------------------------------------------------------------------
# FINANCE
# ------------------------------------------------------------------------------
# Fraction of the delivery fee the driver keeps. This is a commercial lever —
# set it deliberately, not by accident. [OPTIONAL] default: 0.85
#DRIVER_SHARE_RATIO=0.85


# ------------------------------------------------------------------------------
# RATE LIMITING — driver location updates
# The driver app reports roughly every 3 s (~20/min), so 30 per 60 s leaves
# headroom for retries without letting a client flood the server.
# ------------------------------------------------------------------------------
# [OPTIONAL] default: 30
#LOCATION_UPDATE_RATE_LIMIT=30
# [OPTIONAL] default: 60
#LOCATION_UPDATE_WINDOW_SECONDS=60


# ------------------------------------------------------------------------------
# DEVELOPMENT HELPERS — all must stay false/unset in production
# ------------------------------------------------------------------------------
# Unlocks unauthenticated admin helper endpoints.
#   *** MUST REMAIN false IN PRODUCTION ***
# [OPTIONAL] default: false
DEV_ALLOW_ADMIN_ENDPOINTS=false

# Forces every restaurant to a synthetic location for demos.
# [OPTIONAL] default: false
#DEV_FORCE_DEFAULT_RESTAURANT_LOCATION=false

# NOTE: the code defaults below are Mountain View, California — not Harare.
# They only apply when DEV_FORCE_DEFAULT_RESTAURANT_LOCATION=true, but if you
# ever turn that on, set Harare here: lat -17.8292, lng 31.0522.
# [OPTIONAL] default: 37.4219983
#DEV_DEFAULT_BASE_LAT=-17.8292
# [OPTIONAL] default: -122.084
#DEV_DEFAULT_BASE_LNG=31.0522
# Scatter radius, in MILES. [OPTIONAL] default: 5.0
#DEV_DEFAULT_OFFSET_MILES=5.0
