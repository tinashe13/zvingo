# Zvingo Backend Configuration
# Copy this file to .env and fill in your values.
# With ENVIRONMENT=production the app REFUSES TO START unless:
#   - SECRET_KEY is set to a non-default value
#   - PAYMENT_MOCK_MODE=false and PAYNOW_INTEGRATION_ID/KEY are set
#   - SMS_MOCK_MODE=false and AFRICASTALKING_API_KEY is set

# ------------------------------------------------------------------
# Environment: "development" (permissive defaults) or "production"
ENVIRONMENT=development

# ------------------------------------------------------------------
# Database (MongoDB via motor/beanie)
MONGODB_URL=mongodb://mongo:27017/zvingo
MONGODB_DB_NAME=zvingo

# Redis (dispatch pub/sub, OTP, rate limiting, exchange rates)
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------
# Security
# JWT signing key. REQUIRED in production; generate with:
#   openssl rand -hex 32
# Known placeholder values ("changethis", etc.) are rejected in production.
SECRET_KEY=changethis
# JWT algorithm and token lifetime (defaults are usually fine)
#ALGORITHM=HS256
#ACCESS_TOKEN_EXPIRE_MINUTES=11520

# CORS: comma-separated list of allowed browser origins.
# Empty => "*" in development only; in production set this explicitly, e.g.:
#   CORS_ORIGINS=https://app.zvingo.co.zw,https://merchant.zvingo.co.zw
CORS_ORIGINS=

# ------------------------------------------------------------------
# SMS - Africa's Talking (https://africastalking.com/)
# SMS_MOCK_MODE=true: messages are forwarded to SMS_GATEWAY_URL (if set)
# or just logged. Must be false in production.
SMS_MOCK_MODE=true
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
# Optional local mock SMS service used when SMS_MOCK_MODE=true
SMS_GATEWAY_URL=http://sms-mock:8000

# ------------------------------------------------------------------
# Payments - Paynow Zimbabwe (https://www.paynow.co.zw/)
# PAYMENT_MOCK_MODE=true: payments auto-approve after ~3s without contacting
# Paynow. Must be false in production, with real credentials below.
PAYMENT_MOCK_MODE=true
# Get Integration ID and Key from the Paynow merchant dashboard
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RETURN_URL=http://localhost/payment/return
PAYNOW_RESULT_URL=http://localhost/api/payment/webhook

# ------------------------------------------------------------------
# Firebase Cloud Messaging (push notifications)
# 1. Create project at https://console.firebase.google.com/
# 2. Project Settings > Service Accounts > Generate new private key
# 3. Save the JSON file and set the path below
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ------------------------------------------------------------------
# Uploads
# Public base URL used to build image URLs returned by POST /upload
UPLOAD_BASE_URL=http://localhost:8000
# Max accepted upload size in bytes (default 5MB)
#MAX_UPLOAD_SIZE_BYTES=5242880

# ------------------------------------------------------------------
# BinProto (binary location protocol; usually don't need to change)
BINPROTO_UDP_PORT=9090
BINPROTO_TCP_PORT=9091

# ------------------------------------------------------------------
# Dispatch retry (re-offer stuck orders)
#DISPATCH_RETRY_INTERVAL_SECONDS=120
#DISPATCH_MAX_RETRY_ATTEMPTS=10

# ------------------------------------------------------------------
# Finance
# Fraction of the delivery fee the driver keeps
#DRIVER_SHARE_RATIO=0.85

# ------------------------------------------------------------------
# Rate limiting (driver location updates)
#LOCATION_UPDATE_RATE_LIMIT=30
#LOCATION_UPDATE_WINDOW_SECONDS=60

# ------------------------------------------------------------------
# Development helpers (leave off in production)
DEV_ALLOW_ADMIN_ENDPOINTS=false
#DEV_FORCE_DEFAULT_RESTAURANT_LOCATION=false
#DEV_DEFAULT_BASE_LAT=37.4219983
#DEV_DEFAULT_BASE_LNG=-122.084
#DEV_DEFAULT_OFFSET_MILES=5.0
