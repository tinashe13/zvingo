# ==============================================================================
# Zvingo — BACKEND HOST environment  (split deployment, host A of two)
# ==============================================================================
#
#   cp .env.backend.example .env     # then fill in EVERY value marked REQUIRED
#   docker compose -f docker-compose.backend.yml up -d --build
#
# This host runs the API, MongoDB, Redis and an nginx TLS terminator for the API
# domain. The merchant dashboard runs on its OWN host with its own .env — see
# .env.dashboard.example. Nothing here builds Node, so a 2 GB droplet is
# comfortable (4 GB recommended).
#
# Every ${VAR:?} in the compose file fails fast at startup if left empty. There
# are deliberately NO insecure defaults.
#
#   *** NEVER COMMIT THE FILLED-IN .env ***
#   chmod 600 .env
#
# Signup instructions, costs and lead times for every provider below:
#   docs/INTEGRATIONS_AND_CREDENTIALS.md
# ==============================================================================


# ==============================================================================
# 1. DOMAIN AND PUBLIC URLs
# ==============================================================================
# The API domain. Documentation only — you must ALSO edit the two `server_name`
# lines (port 80 and port 443) in nginx/nginx.api.conf by hand.
#
# This hostname is COMPILED INTO the mobile apps via
# --dart-define=API_BASE_URL=..., so changing it later means rebuilding and
# resubmitting both apps to both stores. Decide it once, before you build.
# [REQUIRED]
API_DOMAIN=api.your-domain.com

# Public base URL the backend prefixes onto uploaded-image links. Must be THIS
# host — it is what serves /static/uploads/. A wrong value 404s every photo.
# [REQUIRED]
UPLOAD_BASE_URL=https://api.your-domain.com

# Browser origins allowed to call this API.
#
# [REQUIRED] and LOAD-BEARING in a split deployment: the dashboard is now a
# DIFFERENT origin, so if this does not list the dashboard host, every single
# dashboard request fails CORS. The backend sends credentials, so "*" is not a
# legal value. Comma-separate several origins.
CORS_ORIGINS=https://app.your-domain.com


# ==============================================================================
# 2. SECURITY
# ==============================================================================
# JWT signing key. Anyone holding this can forge a token for ANY user,
# including an admin.
#
#   [REQUIRED] Generate with:  openssl rand -hex 32
#
# Placeholders (changethis, changeme, secret, ...) are rejected by config.py in
# production. Do not pick a memorable phrase.
# Rotating this logs out every user — schedule it for 03:00, not lunchtime.
SECRET_KEY=


# ==============================================================================
# 3. MONGODB  (root credentials — auth is enabled in production)
# ==============================================================================
# The root user is created on the FIRST boot of an empty volume. Changing the
# password here later does NOT change the existing user.
# [REQUIRED]
MONGO_INITDB_ROOT_USERNAME=zvingo_admin

# [REQUIRED] SECRET. Generate with:  openssl rand -hex 24
MONGO_INITDB_ROOT_PASSWORD=

# [OPTIONAL] default: zvingo
MONGODB_DB_NAME=zvingo


# ==============================================================================
# 4. REDIS
# ==============================================================================
# [REQUIRED] SECRET. Generate with:  openssl rand -hex 24
# Redis is NOT published to the host — internal compose network only.
REDIS_PASSWORD=


# ==============================================================================
# 5. PAYMENTS — Paynow Zimbabwe  (https://www.paynow.co.zw/)
# EcoCash / OneMoney / InnBucks. The only way money enters the platform, and a
# confirmed payment is what triggers driver dispatch.
# Signup walkthrough: docs/INTEGRATIONS_AND_CREDENTIALS.md §2.1
# ==============================================================================
# Paynow merchant dashboard -> "Other Ways To Get Paid" -> your integration.
# [REQUIRED]
PAYNOW_INTEGRATION_ID=

# [REQUIRED] SECRET. Never shown on screen: click [Email Key To Company Address].
PAYNOW_INTEGRATION_KEY=

# Browser redirect after payment.
# [REQUIRED]
PAYNOW_RETURN_URL=https://api.your-domain.com/payment/return

# Server-to-server result callback. Must be publicly reachable over HTTPS and
# must match the result URL saved on the integration in the Paynow dashboard.
# The /api prefix is stripped by nginx before proxying; do NOT use /api/v1/...
#
# SECURITY: the handler does not yet validate Paynow's SHA-512 `hash` field.
# Until it does, a forged "paid" callback is accepted. See
# docs/INTEGRATIONS_AND_CREDENTIALS.md §8 — fix before going live.
# [REQUIRED]
PAYNOW_RESULT_URL=https://api.your-domain.com/api/payment/webhook

# [OPTIONAL] compose default: false    *** NEVER true in production ***
#PAYMENT_MOCK_MODE=false


# ==============================================================================
# 6. SMS — Africa's Talking  (https://africastalking.com/)
# Sends the signup OTP and password-reset code. Without working SMS NOBODY CAN
# SIGN UP OR LOG IN. Going live needs Zimbabwean company KYC documents and a
# registered sender ID — allow 1-3 weeks.
# Signup walkthrough: docs/INTEGRATIONS_AND_CREDENTIALS.md §2.2
# ==============================================================================
# Your LIVE app username — NOT the literal string "sandbox". The username is the
# ONLY sandbox/live switch in the code.
# [REQUIRED]
AFRICASTALKING_USERNAME=

# [REQUIRED] SECRET. Shown exactly once at generation.
AFRICASTALKING_API_KEY=

# Pre-paid: an empty balance fails SILENTLY (the OTP endpoint still returns
# success). Monitor the balance and alert on the "SMS send failed" log event.

# SMS_GATEWAY_URL is the dev mock only and is intentionally not set here.

# [OPTIONAL] compose default: false    *** NEVER true in production ***
#SMS_MOCK_MODE=false


# ==============================================================================
# 7. PUSH NOTIFICATIONS — Firebase Cloud Messaging  (free at any volume)
# ==============================================================================
# Path to the service-account JSON inside the backend container. The Dockerfile
# copies backend/firebase-credentials.json to /app, so the default is usually
# right. Push is simply disabled if the file is absent. chmod 600 it on the host.
#
# NOTE: this achieves nothing on its own today — neither Flutter app has an FCM
# client, so User.fcm_token is never populated. See §2.3 of the integrations doc.
# [OPTIONAL] default: firebase-credentials.json
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json


# ==============================================================================
# 8. OBSERVABILITY  (all optional — defaults match app/config.py)
# ==============================================================================
#LOG_LEVEL=INFO

# nginx already denies /api/metrics publicly; scrape
# http://backend:8000/metrics from inside the compose network. A token adds
# bearer auth on top.  Generate with: openssl rand -hex 16
#METRICS_ENABLED=true
#METRICS_TOKEN=

# Tune ALERT_FAILED_PAYMENT_THRESHOLD DOWN for launch — 5 failures is a lot at
# 30 orders/day.
#ALERTS_ENABLED=true
#ALERT_POLL_INTERVAL_SECONDS=300
#ALERT_STUCK_ORDER_MINUTES=30
#ALERT_FAILED_PAYMENT_THRESHOLD=5
#ALERT_WINDOW_MINUTES=60


# ==============================================================================
# 9. SCHEDULED ORDERS  (optional)
# ==============================================================================
#SCHEDULED_POLL_INTERVAL_SECONDS=15
#SCHEDULED_DISPATCH_LEAD_MINUTES=15


# ==============================================================================
# PRE-FLIGHT CHECKLIST — tick all of these before `up -d --build`
# ==============================================================================
#  [ ] SECRET_KEY generated with `openssl rand -hex 32`
#  [ ] MONGO_INITDB_ROOT_PASSWORD and REDIS_PASSWORD generated separately
#  [ ] All four Paynow values filled, integration switched OUT of test mode
#  [ ] Africa's Talking LIVE username (not "sandbox") + funded credit balance
#  [ ] CORS_ORIGINS lists the DASHBOARD host (this is the #1 split-deploy trap)
#  [ ] server_name updated in BOTH server blocks of nginx/nginx.api.conf
#  [ ] TLS certs present at nginx/certs/{fullchain,privkey}.pem
#  [ ] Certificate auto-renewal cron installed (certs expire in 90 days)
#  [ ] firebase-credentials.json in place and chmod 600
#  [ ] This .env is chmod 600 and is NOT tracked by git
#  [ ] Master copies of every secret in the company password manager
#  [ ] Firewall allows 22, 80, 443, 9090/udp, 9091/tcp — and nothing else.
#      9090/9091 are BinProto driver telemetry; they bypass nginx by design and
#      are currently PLAINTEXT.
#  [ ] Database backups configured AND a restore tested
