# Zvingo — BACKEND HOST environment (split deployment).
#
# Usage:
#   cp .env.backend.example .env
#   # fill in EVERY value below, then:
#   docker compose -f docker-compose.backend.yml up -d --build
#
# This host runs the API, MongoDB, and Redis. The merchant dashboard has its
# own host and its own .env (see .env.dashboard.example). Nothing here builds
# Node, so a 2 GB droplet is comfortable.
#
# Every ${VAR:?} in the compose file fails fast at startup if left empty —
# there are no insecure defaults. NEVER commit the filled-in .env.

# ============================================================
# Domain / public URLs
# ============================================================
# The API domain. Also update both server_name lines in nginx/nginx.api.conf.
API_DOMAIN=api.zvingo.example.com

# Public base URL for uploaded-image links. Must be THIS host — it serves
# /static/uploads/.
UPLOAD_BASE_URL=https://api.zvingo.example.com

# Browser origins allowed to call this API. REQUIRED, and load-bearing in a
# split deployment: the dashboard is now a different origin, so list it here
# or every dashboard request fails CORS. The backend sends credentials, so
# "*" is not a legal value. Comma-separated for several origins.
CORS_ORIGINS=https://app.zvingo.example.com

# ============================================================
# Security
# ============================================================
# JWT signing key. REQUIRED. Generate with:  openssl rand -hex 32
SECRET_KEY=

# ============================================================
# MongoDB (root credentials — auth is enabled in production)
# ============================================================
MONGO_INITDB_ROOT_USERNAME=zvingo_admin
# Generate with: openssl rand -hex 24
MONGO_INITDB_ROOT_PASSWORD=
MONGODB_DB_NAME=zvingo

# ============================================================
# Redis
# ============================================================
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=

# ============================================================
# Payments — Paynow Zimbabwe (https://www.paynow.co.zw/)
# ============================================================
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RETURN_URL=https://api.zvingo.example.com/payment/return
PAYNOW_RESULT_URL=https://api.zvingo.example.com/api/payment/webhook

# ============================================================
# SMS — Africa's Talking (https://africastalking.com/)
# Use your LIVE username + API key, not "sandbox".
# ============================================================
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# ============================================================
# Firebase Cloud Messaging (push notifications)
# Path to the service-account JSON inside the backend container. The
# Dockerfile copies backend/firebase-credentials.json to /app, so the default
# is usually right. Push is simply disabled if the file is absent.
# ============================================================
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ============================================================
# Observability (optional — sensible defaults if omitted)
# ============================================================
#LOG_LEVEL=INFO
# nginx already denies /api/metrics publicly; scrape http://backend:8000/metrics
# from inside the compose network. A token adds bearer auth on top.
#METRICS_ENABLED=true
#METRICS_TOKEN=
#ALERTS_ENABLED=true
#ALERT_POLL_INTERVAL_SECONDS=300
#ALERT_STUCK_ORDER_MINUTES=30
#ALERT_FAILED_PAYMENT_THRESHOLD=5

# ============================================================
# Scheduled orders (optional)
# ============================================================
#SCHEDULED_POLL_INTERVAL_SECONDS=15
#SCHEDULED_DISPATCH_LEAD_MINUTES=15
